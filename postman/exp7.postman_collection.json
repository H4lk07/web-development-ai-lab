{
  "info": {
    "name": "Web Development Using AI - Exp 7 Products REST API",
    "description": "Postman test suite for Product Catalog RESTful API (CRUD, Search, Filtering, Pagination, Error Handling)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "02 List Products (All)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "03 Filter Products by Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=electronics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [{ "key": "category", "value": "electronics" }]
        }
      }
    },
    {
      "name": "04 Create Product (Success)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Acoustic Wireless Headphones\",\n  \"description\": \"Active noise cancellation with 40-hour battery life\",\n  \"category\": \"electronics\",\n  \"price\": 149.99,\n  \"quantity\": 20,\n  \"inStock\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "05 Create Product (Validation Failure)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"category\": \"invalid_category\",\n  \"price\": -20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
