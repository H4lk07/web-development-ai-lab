# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Leave blank for local in-memory fallback, or specify MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/webdev_lab?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=webdev_ai_lab_secret_jwt_key_2026_demo

# Artificial Intelligence Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_BASE=http://localhost:5000
